# Local MySQL test database, used only by `composer test:mysql`.
# Copy to .env.testing, set DB_PASSWORD, then run: php artisan key:generate --env=testing
# (plain `php artisan test` still uses SQLite in memory — phpunit.xml wins over this file.)
APP_NAME=ARCS
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arcs_test
DB_USERNAME=root
DB_PASSWORD=
